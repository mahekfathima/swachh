# FastAPI environment
ENVIRONMENT=development

# PostgreSQL + PostGIS (Example connection string for asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/swachhconnect

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION_NAME=ap-south-1
AWS_S3_BUCKET_NAME=swachhconnect-media

# Razorpay / RazorpayX Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Micro-Tender default amount (in INR rupees)
DEFAULT_TENDER_AMOUNT=500.00
